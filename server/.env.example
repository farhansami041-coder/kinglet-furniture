# ============================================================
# KINGLET FURNITURE - ENVIRONMENT VARIABLES CONFIGURATION
# ============================================================

PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5174
DATABASE_URL="file:./dev.db"
JWT_SECRET=kinglet_super_secure_jwt_secret_token_key_2026_xyz
JWT_EXPIRES_IN=7d

# ============================================================
# PRODUCTION OBJECT STORAGE (AWS S3 / CLOUDFLARE R2 / MINIO)
#
# NOTE: If these variables are not configured, the system
# seamlessly operates using the High-Performance Persistent
# Local Object Storage driver (/storage/objects/*) with zero
# mock data, Sharp WebP processing, and full file persistence.
#
# To connect remote Cloud Object Storage:
# 1. Provide your bucket credentials below.
# 2. Restart the server. The adapter automatically detects
#    and routes all image streams to your remote bucket!
# ============================================================
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=your_aws_or_r2_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_or_r2_secret_key
# AWS_REGION=ap-southeast-1
# S3_BUCKET=kinglet-furniture-production
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_PUBLIC_BASE_URL=https://cdn.kingletbd.com

# ============================================================
# BANGLADESH PAYMENT GATEWAYS (SSLCOMMERZ / BKASH / NAGAD)
#
# NOTE: If these variables are not configured, the system
# seamlessly operates in sandbox simulation mode with built-in
# verified payment test screens.
#
# For live merchant operations:
# 1. Register a merchant account at https://sslcommerz.com
# 2. Enter your Store ID and Store Password below.
# 3. Set SSLCOMMERZ_IS_SANDBOX=false for live production transactions.
# ============================================================
SSLCOMMERZ_STORE_ID=test_kinglet_store
SSLCOMMERZ_STORE_PASSWORD=test_kinglet_secret
SSLCOMMERZ_IS_SANDBOX=true
BKASH_MERCHANT_NUMBER=01713393999

